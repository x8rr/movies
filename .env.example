# required
TMDB_API_KEY=           # https://www.themoviedb.org/settings/api

# optional
PORT=3000
HOST=0.0.0.0

# Optional provider key overrides. Normally unnecessary: when a key stops working the
# server re-scrapes the provider's player JS and picks up the new one automatically.
# VIDROCK_KEY=
# VIDSPARK_KEY=
# VIDNEST_SECRET=
